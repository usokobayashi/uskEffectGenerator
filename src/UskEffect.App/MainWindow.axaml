<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:UskEffect.App.Controls.Ui"
        xmlns:controls="using:UskEffect.App.Controls"
        xmlns:views="using:UskEffect.App.Views"
        x:Class="UskEffect.App.MainWindow"
        Title="uskEffect"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Panel x:Name="RootPanel" Opacity="0">
    <DockPanel>
      <views:TopBar x:Name="Top" DockPanel.Dock="Top" />
      <views:StatusBar x:Name="Status" DockPanel.Dock="Bottom" />
      <views:TimelineBar x:Name="Timeline" DockPanel.Dock="Bottom" />

      <views:ToolRail x:Name="Rail" DockPanel.Dock="Left" />

      <!-- 右: 設定のタブ -->
      <Border x:Name="RightPanel" DockPanel.Dock="Right" Width="{StaticResource Ue.Size.RightPanel}" Background="{StaticResource Ue.Panel}"
              BorderBrush="{StaticResource Ue.Line}" BorderThickness="{StaticResource Ue.Line.Left}">
        <DockPanel>
          <Border DockPanel.Dock="Top" Padding="{StaticResource Ue.Pad.Tabs}">
            <ui:SegmentedControl x:Name="TabSegment" SelectedIndex="0">
              <ListBoxItem Content="{DynamicResource S.Tab.Noise}" Padding="2,0" />
              <ListBoxItem Padding="2,0">
                <StackPanel Orientation="Horizontal" Spacing="3">
                  <TextBlock Text="{DynamicResource S.Tab.Seam}" />
                  <TextBlock x:Name="SeamMarkText" FontWeight="Bold" />
                </StackPanel>
              </ListBoxItem>
              <ListBoxItem Content="{DynamicResource S.Tab.Effect}" Padding="2,0" />
              <ListBoxItem Content="{DynamicResource S.Tab.Layer}" Padding="2,0" />
            </ui:SegmentedControl>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel Margin="{StaticResource Ue.Pad.Body}">
              <views:NoisePanel x:Name="NoiseTab" />
              <views:SeamPanel x:Name="SeamTab" IsVisible="False" />
              <views:EffectPanel x:Name="EffectTab" IsVisible="False" />
              <views:LayerPanel x:Name="LayerTab" IsVisible="False" />
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 中央: 表示の切り替えとキャンバス。キャンバスは子 HWND なので上に部品を重ねない -->
      <DockPanel>
        <views:ViewStrip x:Name="Strip" DockPanel.Dock="Top" />
        <Border Background="{StaticResource Ue.Stage}">
          <controls:D3DHost x:Name="Viewport" />
        </Border>
      </DockPanel>
    </DockPanel>
  </Panel>
</Window>
