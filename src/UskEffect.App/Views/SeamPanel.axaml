<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:UskEffect.App.Controls.Ui"
             x:Class="UskEffect.App.Views.SeamPanel">
  <StackPanel Spacing="{StaticResource Ue.Gap.Row}">
    <Border Classes="chip">
      <StackPanel Spacing="{StaticResource Ue.Gap.Tight}">
        <TextBlock x:Name="VerdictText" FontWeight="Bold" TextWrapping="Wrap" />
        <TextBlock x:Name="DetailText" Classes="muted mono" />
      </StackPanel>
    </Border>
    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Ue.Gap.Normal}">
      <TextBlock Classes="rowLabel" Text="{DynamicResource S.Seam.Overlay}" />
      <ui:SegmentedControl x:Name="HeatmapSegment" Grid.Column="1" SelectedIndex="1">
        <ListBoxItem Content="{DynamicResource S.Seam.OverlayOff}" Padding="2,0" />
        <ListBoxItem Content="{DynamicResource S.Seam.OverlayValue}" Padding="2,0" />
        <ListBoxItem Content="{DynamicResource S.Seam.OverlayGradient}" Padding="2,0" />
      </ui:SegmentedControl>
    </Grid>
    <ui:SliderField x:Name="ThresholdField" Label="{DynamicResource S.Seam.Threshold}" Minimum="1.5" Maximum="10" Value="5" Step="0.1" ValueFormat="0.0×" IsExpandable="True" />

    <TextBlock Classes="heading" Text="{DynamicResource S.Seam.Fix}" Margin="{StaticResource Ue.Margin.Heading}" />
    <StackPanel x:Name="FixButtons" Orientation="Horizontal" Spacing="{StaticResource Ue.Gap.Normal}">
      <Button x:Name="ManualFixButton" Classes="btn" Content="{DynamicResource S.Seam.FixOffset}" />
      <Button x:Name="BlendButton" Classes="btn" Content="{DynamicResource S.Seam.FixBlend}" />
    </StackPanel>
    <StackPanel x:Name="BlendControls" Spacing="{StaticResource Ue.Gap.Row}" IsVisible="False">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="{StaticResource Ue.Gap.Normal}">
        <TextBlock Classes="rowLabel" Text="{DynamicResource S.Seam.BlendAxis}" />
        <ui:SegmentedControl x:Name="BlendAxisSegment" Grid.Column="1" SelectedIndex="2">
          <ListBoxItem Content="{DynamicResource S.Seam.BlendAxisX}" Padding="2,0" />
          <ListBoxItem Content="{DynamicResource S.Seam.BlendAxisY}" Padding="2,0" />
          <ListBoxItem Content="{DynamicResource S.Seam.BlendAxisBoth}" Padding="2,0" />
        </ui:SegmentedControl>
      </Grid>
      <ui:SliderField x:Name="BlendWidthField" Label="{DynamicResource S.Seam.BlendWidth}" Minimum="0.01" Maximum="0.5" Value="0.1" Step="0.01" />
      <ui:SliderField x:Name="BlendStrengthField" Label="{DynamicResource S.Seam.BlendStrength}" Minimum="0" Maximum="1" Value="1" Step="0.01" />
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{StaticResource Ue.Gap.Normal}">
        <Button x:Name="BlendCancelButton" Classes="btn" Content="{DynamicResource S.Seam.BlendCancel}" />
        <Button x:Name="BlendApplyButton" Classes="btn" Content="{DynamicResource S.Seam.BlendApply}" />
      </StackPanel>
    </StackPanel>
  </StackPanel>
</UserControl>
