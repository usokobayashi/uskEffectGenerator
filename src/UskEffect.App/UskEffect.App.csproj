<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="UskEffect.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UskEffect.Graphics\UskEffect.Graphics.csproj" />
    <ProjectReference Include="..\UskEffect.Core\UskEffect.Core.csproj" />
  </ItemGroup>

  <!-- HLSL は実行時コンパイル。開発時はリポジトリ直下の Shaders/ を直接監視し、無ければ出力先のコピーを使う。 -->
  <ItemGroup>
    <Content Include="..\..\Shaders\**\*.hlsl" Link="Shaders\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
