<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UskEffect.App.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <MergeResourceInclude Source="/Theme/Controls.axaml" />
        <MergeResourceInclude Source="/Locale/ja.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme>
      <!-- メニューなど、標準のまま使う部品もアプリの配色にそろえる -->
      <FluentTheme.Palettes>
        <ColorPaletteResources x:Key="Dark" Accent="#56C8D0" RegionColor="#262B30" BaseHigh="#E4E8EB" BaseMedium="#A3ACB4" />
      </FluentTheme.Palettes>
    </FluentTheme>
    <StyleInclude Source="/Theme/Styles.axaml" />
  </Application.Styles>
</Application>
