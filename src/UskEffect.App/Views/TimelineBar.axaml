<!-- 下部: エフェクトの再生。画面の並びを変えないよう常に表示する -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:UskEffect.App.Controls.Ui"
             x:Class="UskEffect.App.Views.TimelineBar">
  <Border Classes="bar" BorderThickness="{StaticResource Ue.Line.Top}">
    <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="{StaticResource Ue.Gap.Line}">
      <Button x:Name="PlayButton" Classes="ico" VerticalAlignment="Center">
        <Path x:Name="PlayIcon" Classes="stroke icon" Data="{StaticResource Icon.Play}" />
      </Button>
      <Button x:Name="StopButton" Grid.Column="1" Classes="ico" VerticalAlignment="Center"
              ToolTip.Tip="{DynamicResource S.Timeline.Stop}" AutomationProperties.Name="{DynamicResource S.Timeline.Stop}">
        <Path Classes="stroke icon" Data="{StaticResource Icon.Stop}" />
      </Button>
      <ui:SliderField x:Name="ScrubField" Grid.Column="2" Height="{StaticResource Ue.Size.Scrub}" Background="{StaticResource Ue.Ground}"
                      Minimum="0" Maximum="1" Step="0.001" ValueFormat="&quot;&quot;" VerticalAlignment="Center"
                      AutomationProperties.Name="{DynamicResource S.Timeline.Position}" />
      <TextBlock x:Name="TimeText" Grid.Column="3" Classes="muted mono" VerticalAlignment="Center" />
      <Border Grid.Column="4" Classes="sep" />
      <TextBlock Grid.Column="5" Classes="muted" Text="{DynamicResource S.Timeline.Loop}" VerticalAlignment="Center" />
      <ui:SwitchButton x:Name="LoopSwitch" Grid.Column="6" IsChecked="True" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource S.Timeline.Loop}" />
      <Border Grid.Column="7" Classes="sep" />
      <TextBlock Grid.Column="8" Classes="muted" Text="{DynamicResource S.Timeline.Duration}" VerticalAlignment="Center" />
      <ui:NumberField x:Name="DurationField" Grid.Column="9" Width="{StaticResource Ue.Size.Duration}" VerticalAlignment="Center"
                      Minimum="0.1" Maximum="60" Increment="0.5" Value="2" FormatString="0.0" AutomationProperties.Name="{DynamicResource S.Timeline.DurationAria}" />
    </Grid>
  </Border>
</UserControl>
