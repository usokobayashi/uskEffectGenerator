<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:UskEffect.App.Controls.Ui"
        xmlns:controls="using:UskEffect.App.Controls"
        xmlns:views="using:UskEffect.App.Views"
        x:Class="UskEffect.App.MainWindow"
        Title="uskEffect"
        Width="1280" Height="800" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterScreen" WindowState="Maximized">
  <Panel x:Name="RootPanel" Opacity="0">
    <DockPanel>
      <views:TopBar x:Name="Top" DockPanel.Dock="Top" />
      <views:StatusBar x:Name="Status" DockPanel.Dock="Bottom" />

      <views:ToolRail x:Name="Rail" DockPanel.Dock="Left" />

      <!-- 右: 設定のタブ -->
      <Border x:Name="RightPanel" DockPanel.Dock="Right" Width="{StaticResource Ue.Size.RightPanel}" Background="{StaticResource Ue.Panel}"
              BorderBrush="{StaticResource Ue.Line}" BorderThickness="{StaticResource Ue.Line.Left}">
        <DockPanel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Panel Margin="{StaticResource Ue.Pad.Body}">
              <views:NoisePanel x:Name="NoiseTab" />
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- 中央: 表示の切り替えとキャンバス。キャンバスは子 HWND なので上に部品を重ねない -->
      <DockPanel>
        <views:ViewStrip x:Name="Strip" DockPanel.Dock="Top" />
        <Border Background="{StaticResource Ue.Stage}">
          <controls:D3DHost x:Name="Viewport" />
        </Border>
      </DockPanel>
    </DockPanel>

    <!-- 出力の完了。キャンバスの上には重ねられないので、上部のバーの上に出す -->
    <Border x:Name="ExportBanner" Classes="reveal" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,4,0,0" Padding="10,4"
            MaxWidth="640" Background="{StaticResource Ue.Fill}" BorderBrush="{StaticResource Ue.Accent}" BorderThickness="{StaticResource Ue.Line.All}"
            CornerRadius="{StaticResource Ue.Radius}" Cursor="Hand">
      <TextBlock x:Name="ExportBannerText" TextTrimming="CharacterEllipsis" />
    </Border>
  </Panel>
</Window>
