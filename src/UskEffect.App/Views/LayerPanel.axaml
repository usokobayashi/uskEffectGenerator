<!-- レイヤー。ペイント機能ができるまで無効の見た目で場所を確保する -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UskEffect.App.Views.LayerPanel">
  <StackPanel Spacing="{StaticResource Ue.Gap.Row}">
    <Border Classes="layer">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="{StaticResource Ue.Gap.Line}">
        <Button Classes="ico" IsEnabled="False" AutomationProperties.Name="{DynamicResource S.Layer.ToggleVisible}">
          <Path Classes="stroke icon" Data="{StaticResource Icon.Eye}" />
        </Button>
        <TextBlock Grid.Column="1" Text="{DynamicResource S.Layer.Noise}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Grid.Column="2" Classes="muted mono" Text="100%" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Ue.Gap.Normal}">
      <Button Classes="btn" Content="{DynamicResource S.Layer.Add}" IsEnabled="False" />
      <Button Classes="btn" Content="{DynamicResource S.Layer.Delete}" IsEnabled="False" />
    </StackPanel>
    <TextBlock Classes="muted" Text="{DynamicResource S.Layer.Note}" TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
