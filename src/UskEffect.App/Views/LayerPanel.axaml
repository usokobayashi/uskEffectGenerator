<!-- レイヤー (FR-15)。上にあるものほど手前。一番下の元の画像は固定 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:UskEffect.App.Controls.Ui"
             x:Class="UskEffect.App.Views.LayerPanel">
  <StackPanel Spacing="{StaticResource Ue.Gap.Row}">
    <ui:SliderField x:Name="OpacityField" Label="{DynamicResource S.Layer.Opacity}" Minimum="0" Maximum="1" Value="1" Step="0.01" />
    <StackPanel x:Name="LayerList" Spacing="{StaticResource Ue.Gap.Tight}" />
    <Border Classes="layer">
      <TextBlock Classes="muted" Text="{DynamicResource S.Layer.Source}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
    </Border>
    <StackPanel Orientation="Horizontal" Spacing="{StaticResource Ue.Gap.Normal}">
      <Button x:Name="AddButton" Classes="btn" Content="{DynamicResource S.Layer.Add}" />
      <Button x:Name="DeleteButton" Classes="btn" Content="{DynamicResource S.Layer.Delete}" />
      <Button x:Name="MoveUpButton" Classes="btn" Content="{DynamicResource S.Layer.MoveUp}" />
      <Button x:Name="MoveDownButton" Classes="btn" Content="{DynamicResource S.Layer.MoveDown}" />
    </StackPanel>
  </StackPanel>
</UserControl>
